{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vaseraos",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // D1 — relational store for residents, flats, bills, complaints, visitors, notices
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vaseraos-db",
      "migrations_dir": "db/migrations"
    }
  ],

  // R2 — notice attachments, maintenance invoices, visitor photos
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "vaseraos-uploads" }],

  // KV — lightweight session / feature-flag / cache store
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "local-sessions" }]
}
